# 生产环境配置

# API基础URL - 使用网关服务
VITE_API_BASE_URL=http://your-domain.com:8080/api/v1

# 微服务地址（生产环境）
VITE_KNOWLEDGE_SERVICE_URL=http://your-domain.com:8082/api/v1
VITE_AGENT_SERVICE_URL=http://your-domain.com:8081/api/v1
VITE_MODEL_SERVICE_URL=http://your-domain.com:8088/api/v1
VITE_GRAPH_SERVICE_URL=http://your-domain.com:8087/api/v1/graphs
VITE_KAIBAN_SERVICE_URL=http://your-domain.com:8092/api/v1
VITE_REPORTS_SERVICE_URL=http://your-domain.com:8091/api/v1

# 特殊服务地址
VITE_AGENT_ORCHESTRATION_URL=http://your-domain.com:8000
VITE_AGENT_ORCHESTRATION_IFRAME_URL=http://your-domain.com:3000

# 是否使用模拟数据
VITE_USE_MOCK_DATA=false

# 生产环境标识
NODE_ENV=production
