# 前端环境配置

# API基础URL - 网关服务地址
VITE_API_BASE_URL=http://localhost:8080/api/v1

# 微服务直连地址（开发环境）
VITE_KNOWLEDGE_SERVICE_URL=http://localhost:8082/api/v1
VITE_AGENT_SERVICE_URL=http://localhost:8081/api/v1
VITE_MODEL_SERVICE_URL=http://localhost:8088/api/v1
VITE_GRAPH_SERVICE_URL=http://localhost:8087/api/v1/graphs
VITE_KAIBAN_SERVICE_URL=http://localhost:8092/api/v1
VITE_REPORTS_SERVICE_URL=http://localhost:8091/api/v1

# 特殊服务地址
VITE_AGENT_ORCHESTRATION_URL=http://localhost:8000
VITE_AGENT_ORCHESTRATION_IFRAME_URL=http://localhost:3000

# 是否使用模拟数据
VITE_USE_MOCK_DATA=false

# 开发环境标识
NODE_ENV=development
