import React from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { message } from 'antd';
import ChatModal from '../components/modules/chat/ChatModal';
import SettingsModal from '../components/modules/chat/SettingsModal';
import { useAssistantInfo } from '../hooks/assistants/useAssistantInfo';
import { useChat, useChatHistory, useChatSettings } from '../hooks/chat';

/**
 * 助手聊天页面
 * 
 * 使用自定义hooks管理状态，提供与AI助手对话的界面
 */
const AssistantChat: React.FC = () => {
  const { assistantId } = useParams<{ assistantId: string }>();
  const navigate = useNavigate();

  // 使用hooks管理各部分状态
  const { assistant, loading: assistantLoading } = useAssistantInfo(assistantId);
  const { 
    messages, 
    inputValue, 
    sending, 
    messagesEndRef, 
    setInputValue, 
    sendMessage 
  } = useChat(assistantId);
  
  const { 
    chatHistory, 
    createNewChat, 
    deleteChat, 
    getChat 
  } = useChatHistory();

  const { 
    settings, 
    settingsVisible, 
    updateSettings, 
    openSettings, 
    closeSettings 
  } = useChatSettings();

  // 关闭对话框
  const handleClose = () => {
    navigate(-1);
  };

  // 删除聊天记录
  const handleDeleteChat = (chatId: string, e: React.MouseEvent) => {
    e.stopPropagation();
    deleteChat(chatId);
    message.success('对话已删除');
  };

  // 创建新聊天
  const handleNewChat = () => {
    const newChatId = createNewChat();
    navigate(`/chat/${newChatId}`);
  };

  // 选择历史聊天
  const handleSelectChat = (chatId: string) => {
    navigate(`/chat/${chatId}`);
  };

  // 保存设置
  const handleSettingsSave = (newSettings: any) => {
    updateSettings(newSettings);
    message.success('设置已保存');
  };

  return (
    <>
      <ChatModal
        assistant={assistant}
        messages={messages}
        chatHistory={chatHistory} 
        inputValue={inputValue}
        sending={sending}
        onInputChange={setInputValue}
        onSend={sendMessage}
        onClose={handleClose}
        onSettingsClick={openSettings}
        onNewChat={handleNewChat}
        onDeleteChat={handleDeleteChat}
        onSelectChat={handleSelectChat}
        messagesEndRef={messagesEndRef}
      />

      {/* 设置对话框 */}
      <SettingsModal 
        visible={settingsVisible} 
        onClose={closeSettings}
        settings={settings}
        onSave={handleSettingsSave}
      />
    </>
  );
};

export default AssistantChat;
