{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist",
    /* 移除rootDir限制，让TypeScript可以处理项目外部的文件 */
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  /* 同时包含src目录和shared/types目录 */
  "include": ["src/**/*", "../shared/types/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
